# Copy to .env and adjust. Generate secrets with: openssl rand -hex 32

# Public host name of this server, used for routing and the TLS certificate
ANTIMONY_HOST=antimony.example.com
# E-mail address for Let's Encrypt
ACME_EMAIL=admin@example.com

# Admin login
SB_NATIVE_USERNAME=admin
SB_NATIVE_PASSWORD=

# Secret for login tokens. Keeps users signed in across restarts.
SB_JWT_SECRET=

# Database passwords
POSTGRES_PASSWORD=
SB_DATABASE_PASSWORD=

# OpenID Connect client secret, if you use OpenID Connect
SB_OIDC_SECRET=
