# Copy to .env and adjust. Generate secrets with: openssl rand -hex 32

# Port of the web interface, served over plain HTTP
SB_PORT=8080

# Version of Antimony, e.g. 1.4.2, or dev for the development branch. Without it, the version of the
# release you downloaded is used.
# ANTIMONY_VERSION=dev

# Admin login
SB_ADMIN_USERNAME=admin
SB_ADMIN_PASSWORD=

# Secret for login tokens. Keeps users signed in across restarts.
SB_JWT_SECRET=

# Database passwords
POSTGRES_PASSWORD=
SB_DATABASE_PASSWORD=

# OpenID Connect client secret, if you use OpenID Connect
SB_OIDC_SECRET=

# Log level of the server: debug, info, warn, error or fatal
SB_LOG_LEVEL=info
