# Environment of the interface build used by the e2e tests. Same values as docker/.env: the browser
# calls /api and /socket.io on its own origin, which the preview server proxies to the backend.
SB_API_SERVER_URL=/api
SB_SOCKET_SERVER_URL=
SB_CLAB_SCHEMA_URL=https://raw.githubusercontent.com/srl-labs/containerlab/refs/heads/main/schemas/clab.schema.json
