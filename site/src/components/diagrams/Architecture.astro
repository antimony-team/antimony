---
// Antimony's layers, matching the packages of server/src: transport, services (domain and runtime) and
// infrastructure, with the clients above and the external systems below.
import containerlabMark from '../../assets/containerlab.svg?raw';
// The clabernetes logo, cropped and scaled down from docs-site/app/assets/c9s-logo-clean.png in the clabernetes
// repository
import clabernetesLogo from '../../assets/clabernetes.png';
import { icon } from './icons';

// Places the containerlab mark at the given position and size
const containerlabAt = (x: number, y: number, size: number) =>
	containerlabMark.replace('<svg ', `<svg x="${x}" y="${y}" width="${size}" height="${size}" `);
---

<figure class="diagram">
	<svg viewBox="0 0 1000 746" role="img" aria-labelledby="arch-title arch-desc">
		<title id="arch-title">Antimony architecture</title>
		<desc id="arch-desc">
			The web interface and Antimony Desktop talk to the server's REST API and Socket.IO, SSH clients and Wireshark to its
			SSH server. The transport layer calls the domain services and the runtime; the runtime also uses the domain
			services. Below them, the infrastructure layer holds the database repositories, auth, file storage and the
			deployment provider (containerlab, clabernetes or dummy). These talk to PostgreSQL or SQLite, an OpenID provider,
			the disk, and containerlab on Docker or clabernetes on Kubernetes.
		</desc>
		<defs>
			<marker id="ar-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="arrow" />
			</marker>
			<marker id="ar-aa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="arrow-accent" />
			</marker>
		</defs>

		<!-- Clients -->
		<rect x="40" y="20" width="620" height="88" rx="14" class="zone" />
		<text x="56" y="42" class="t-zone">Interface</text>
		<rect x="56" y="52" width="290" height="42" rx="10" class="box" />
		<g set:html={icon('app-window', 72, 65)} />
		<text x="96" y="78" class="t">Web interface</text>
		<text x="214" y="78" class="t-sub">browser</text>
		<rect x="354" y="52" width="290" height="42" rx="10" class="box" />
		<g set:html={icon('computer', 370, 65)} />
		<text x="394" y="78" class="t">Antimony Desktop</text>
		<text x="544" y="78" class="t-sub">Electron</text>
		<rect x="680" y="32" width="280" height="62" rx="10" class="box" />
		<g set:html={icon('terminal', 696, 44)} />
		<text x="720" y="57" class="t">SSH client · Wireshark</text>
		<text x="696" y="76" class="t-sub">shells and packet capture</text>

		<!-- Server -->
		<rect x="40" y="140" width="920" height="416" rx="16" class="box-accent" />
		<g set:html={icon('server', 60, 155)} />
		<text x="84" y="168" class="t">Antimony server</text>
		<text x="940" y="168" class="t-mono" text-anchor="end">server/</text>

		<!-- transport -->
		<text x="60" y="198" class="t-zone">Transport</text>
		<rect x="60" y="208" width="280" height="54" rx="8" class="box" />
		<g set:html={icon('code-brackets', 76, 220)} />
		<text x="100" y="233" class="t">REST API</text>
		<text x="76" y="252" class="t-mono">transport/http · gin</text>
		<rect x="360" y="208" width="280" height="54" rx="8" class="box" />
		<g set:html={icon('data-transfer-both', 376, 220)} />
		<text x="400" y="233" class="t">Socket.IO</text>
		<text x="376" y="252" class="t-mono">socket · live events, terminals</text>
		<rect x="660" y="208" width="280" height="54" rx="8" class="box" />
		<g set:html={icon('terminal', 676, 220)} />
		<text x="700" y="233" class="t">SSH server</text>
		<text x="676" y="252" class="t-mono">sshserver · :6969</text>

		<!-- services -->
		<text x="60" y="300" class="t-zone">Services</text>
		<rect x="60" y="310" width="420" height="108" rx="8" class="box" />
		<g set:html={icon('view-grid', 76, 322)} />
		<text x="100" y="335" class="t">Domain services</text>
		<text x="464" y="335" class="t-mono" text-anchor="end">domain/*</text>
		<rect x="76" y="348" width="90" height="26" rx="6" class="box" />
		<text x="87" y="365" class="t-sub">collections</text>
		<rect x="174" y="348" width="84" height="26" rx="6" class="box" />
		<text x="185" y="365" class="t-sub">topologies</text>
		<rect x="266" y="348" width="47" height="26" rx="6" class="box" />
		<text x="277" y="365" class="t-sub">labs</text>
		<rect x="321" y="348" width="53" height="26" rx="6" class="box" />
		<text x="332" y="365" class="t-sub">users</text>
		<rect x="76" y="382" width="65" height="26" rx="6" class="box" />
		<text x="87" y="399" class="t-sub">devices</text>
		<rect x="149" y="382" width="59" height="26" rx="6" class="box" />
		<text x="160" y="399" class="t-sub">schema</text>
		<rect x="216" y="382" width="103" height="26" rx="6" class="box" />
		<text x="227" y="399" class="t-sub">server config</text>
		<rect x="327" y="382" width="115" height="26" rx="6" class="box" />
		<text x="338" y="399" class="t-sub">status messages</text>
		<rect x="520" y="310" width="420" height="108" rx="8" class="box" />
		<g set:html={icon('cpu', 536, 322)} />
		<text x="560" y="335" class="t">Runtime</text>
		<text x="924" y="335" class="t-mono" text-anchor="end">runtime/*</text>
		<rect x="536" y="348" width="78" height="26" rx="6" class="box" />
		<text x="547" y="365" class="t-sub">scheduler</text>
		<rect x="622" y="348" width="78" height="26" rx="6" class="box" />
		<text x="633" y="365" class="t-sub">instances</text>
		<rect x="536" y="382" width="59" height="26" rx="6" class="box" />
		<text x="547" y="399" class="t-sub">shells</text>
		<rect x="603" y="382" width="72" height="26" rx="6" class="box" />
		<text x="614" y="399" class="t-sub">commands</text>

		<!-- infrastructure -->
		<text x="60" y="456" class="t-zone">Infrastructure</text>
		<rect x="60" y="466" width="200" height="70" rx="8" class="box" />
		<g set:html={icon('database', 76, 478)} />
		<text x="100" y="491" class="t">Database</text>
		<text x="76" y="510" class="t-sub">GORM repositories</text>
		<rect x="280" y="466" width="200" height="70" rx="8" class="box" />
		<g set:html={icon('lock', 296, 478)} />
		<text x="320" y="491" class="t">Auth</text>
		<text x="296" y="510" class="t-sub">logins, tokens, OIDC</text>
		<rect x="520" y="466" width="200" height="70" rx="8" class="box" />
		<g set:html={icon('folder', 536, 478)} />
		<text x="560" y="491" class="t">Storage</text>
		<text x="536" y="510" class="t-sub">topology and run files</text>
		<rect x="740" y="466" width="200" height="70" rx="8" class="box" />
		<g set:html={icon('puzzle', 756, 478)} />
		<text x="780" y="491" class="t">Deployment provider</text>
		<text x="756" y="510" class="t-sub">containerlab, clabernetes</text>
		<text x="756" y="526" class="t-sub">or dummy</text>

		<!-- External -->
		<text x="60" y="594" class="t-zone">External</text>
		<rect x="60" y="604" width="200" height="62" rx="10" class="box" />
		<g set:html={icon('database', 76, 616)} />
		<text x="100" y="629" class="t">PostgreSQL / SQLite</text>
		<text x="76" y="648" class="t-sub">labs, topologies, users</text>
		<rect x="280" y="604" width="200" height="62" rx="10" class="box" />
		<g set:html={icon('key', 296, 616)} />
		<text x="320" y="629" class="t">OpenID provider</text>
		<text x="296" y="648" class="t-sub">Keycloak, Entra ID, …</text>
		<rect x="520" y="604" width="200" height="62" rx="10" class="box" />
		<g set:html={icon('hard-drive', 536, 616)} />
		<text x="560" y="629" class="t">Disk</text>
		<text x="536" y="648" class="t-mono">storage/ · run/</text>
		<!-- one of the two, depending on the provider -->
		<rect x="740" y="604" width="200" height="122" rx="10" class="box" />
		<rect x="752" y="616" width="176" height="46" rx="8" class="box" />
		<g class="logo-containerlab" set:html={containerlabAt(762, 623, 32)} />
		<text x="804" y="636" class="t">containerlab</text>
		<text x="804" y="653" class="t-sub">on Docker</text>
		<rect x="752" y="668" width="176" height="46" rx="8" class="box" />
		<image href={clabernetesLogo.src} x="767.4" y="674" width="21.2" height="34" />
		<text x="804" y="688" class="t">clabernetes</text>
		<text x="804" y="705" class="t-sub">on Kubernetes</text>

		<!-- clients -> transport -->
		<path d="M350 108 V114 Q 350 124, 340 124 H250 Q 240 124, 240 134 V204" class="edge" marker-end="url(#ar-a)" />
		<path d="M350 108 V114 Q 350 124, 360 124 H490 Q 500 124, 500 134 V204" class="edge" marker-end="url(#ar-a)" />
		<path d="M800 94 V204" class="edge edge-dashed" marker-end="url(#ar-a)" />

		<!-- transport -> services -->
		<path d="M240 262 V306" class="edge" marker-end="url(#ar-a)" />
		<path d="M440 262 V306" class="edge" marker-end="url(#ar-a)" />
		<path d="M560 262 V306" class="edge" marker-end="url(#ar-a)" />
		<path d="M800 262 V306" class="edge" marker-end="url(#ar-a)" />
		<path d="M520 364 H484" class="edge" marker-end="url(#ar-a)" />

		<!-- services -> infrastructure -->
		<path d="M210 418 V462" class="edge" marker-end="url(#ar-a)" />
		<path d="M380 418 V462" class="edge" marker-end="url(#ar-a)" />
		<path d="M620 418 V462" class="edge" marker-end="url(#ar-a)" />
		<path d="M840 418 V462" class="edge-accent" marker-end="url(#ar-aa)" />

		<!-- infrastructure -> external -->
		<path d="M210 536 V600" class="edge" marker-end="url(#ar-a)" />
		<path d="M380 536 V600" class="edge edge-dashed" marker-end="url(#ar-a)" />
		<path d="M620 536 V600" class="edge" marker-end="url(#ar-a)" />
		<path d="M840 536 V600" class="edge-accent" marker-end="url(#ar-aa)" />
	</svg>
	<figcaption>
		Antimony's layers. The transport layer hands requests to the domain services and the runtime, which use the infrastructure layer below them. Exactly one deployment provider is active, set in the configuration. The dashed lines are optional: SSH access and OpenID Connect.
	</figcaption>
</figure>

<style>
	/* The mark's outline is black on containerlab.dev's light theme */
	.logo-containerlab :global(.outline) {
		fill: var(--sl-color-white);
	}

	svg :global(.icon) {
		color: var(--sl-color-accent);
	}
</style>
