---
// The layers of the topology editor's graph, lifted apart in a loop. Hovering holds them apart, hovering a layer
// highlights it and names the components that draw it. In the docs it's framed like the other diagrams, on the
// landing page it stands on its own with the landing page's colors as fallbacks.
interface Props {
	framed?: boolean;
}

const { framed = true } = Astro.props;
---

<figure class:list={['editor-layers', { diagram: framed }]}>
	<svg viewBox="0 0 850 520" role="img" aria-labelledby="el-title el-desc">
		<title id="el-title">Layers of the topology editor</title>
		<desc id="el-desc">
			Four stacked layers share one pan and zoom. From the bottom: the graph container with the dot grid, the
			underlay with groups, shapes and lines, the Cytoscape canvas with nodes and links, and the overlay with
			texts, the selection and its handles.
		</desc>
		<defs>
			<pattern id="el-dots" width="20" height="20" patternUnits="userSpaceOnUse">
				<circle cx="10" cy="10" r="1.2" class="dot" />
			</pattern>
		</defs>

		<!-- Each layer is drawn flat on a 320 × 200 plane and projected isometrically. The stack spreads from its
		     middle, so it stays centered whether it's apart or together. -->
		<g transform="translate(190 137.5)">
			<g class="layer" style="--step: 0">
				<g transform="matrix(0.866 0.5 -0.866 0.5 0 0)">
					<rect class="plate base" width="320" height="200" rx="10" />
					<rect width="320" height="200" rx="10" fill="url(#el-dots)" />
				</g>
				<g class="label">
					<line class="leader" x1="284" y1="160" x2="302" y2="160" />
					<text class="label-title" x="310" y="157">Graph container</text>
					<text class="label-text" x="310" y="174">dot grid in the background</text>
					<text class="label-detail" x="310" y="191">TopologyGraph</text>
				</g>
			</g>

			<g class="layer" style="--step: 1">
				<g transform="matrix(0.866 0.5 -0.866 0.5 0 0)">
					<rect class="plate" width="320" height="200" rx="10" />
					<rect x="24" y="24" width="136" height="126" rx="10" class="group" />
					<rect x="208" y="28" width="88" height="56" rx="8" class="rectangle" />
					<ellipse cx="252" cy="148" rx="40" ry="26" class="ellipse" />
					<line x1="160" y1="87" x2="199.6" y2="61.4" class="line" />
					<path d="M208 56 L202.3 65.6 L196.9 57.2 Z" class="arrowhead" />
				</g>
				<g class="label">
					<line class="leader" x1="284" y1="160" x2="302" y2="160" />
					<text class="label-title" x="310" y="157">Underlay</text>
					<text class="label-text" x="310" y="174">groups, shapes and lines</text>
					<text class="label-detail" x="310" y="191">AnnotationLayer, EdgeHalo</text>
				</g>
			</g>

			<g class="layer" style="--step: 2">
				<g transform="matrix(0.866 0.5 -0.866 0.5 0 0)">
					<rect class="plate" width="320" height="200" rx="10" />
					<g class="link">
						<line x1="60" y1="58" x2="124" y2="58" />
						<line x1="60" y1="58" x2="92" y2="118" />
						<line x1="124" y1="58" x2="92" y2="118" />
					</g>
					<g class="node">
						<circle cx="60" cy="58" r="14" />
						<circle cx="124" cy="58" r="14" />
						<circle cx="92" cy="118" r="14" />
					</g>
				</g>
				<g class="label">
					<line class="leader" x1="284" y1="160" x2="302" y2="160" />
					<text class="label-title" x="310" y="157">Cytoscape canvas</text>
					<text class="label-text" x="310" y="174">nodes and links</text>
					<text class="label-detail" x="310" y="191">Cytoscape</text>
				</g>
			</g>

			<g class="layer" style="--step: 3">
				<g transform="matrix(0.866 0.5 -0.866 0.5 0 0)">
					<rect class="plate" width="320" height="200" rx="10" />
					<g class="text-line">
						<rect x="28" y="166" width="72" height="5" rx="2.5" />
						<rect x="28" y="176" width="48" height="5" rx="2.5" />
					</g>
					<rect x="202" y="22" width="100" height="68" rx="2" class="selection" />
					<g class="connection-arrow">
						<path d="M252 104 L246 113 L258 113 Z" />
						<path d="M252 192 L246 183 L258 183 Z" />
						<path d="M310 148 L301 142 L301 154 Z" />
						<path d="M194 148 L203 142 L203 154 Z" />
					</g>
				</g>
				<g class="label">
					<line class="leader" x1="284" y1="160" x2="302" y2="160" />
					<text class="label-title" x="310" y="157">Overlay</text>
					<text class="label-text" x="310" y="174">texts, selection and handles</text>
					<text class="label-detail" x="310" y="191">TextLayer, SelectionLayer, LineHandles, MoveableHandles</text>
				</g>
			</g>
		</g>
	</svg>
	<figcaption>Hover the diagram to hold the layers apart, and a layer to see which components draw it.</figcaption>
</figure>

<style>
	/*
	 * The loop and the hover each move a number between 0 and 1, the gap between the layers follows a mix of both,
	 * from 25px when they're together to 75px when they're apart. The hover is a transition, so the layers glide from
	 * wherever the loop is to fully apart and back.
	 */
	@property --el-loop {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --el-labels {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --el-hover {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	svg {
		animation:
			el-loop 8s ease-in-out infinite,
			el-labels 8s ease-in-out infinite;
		transition: --el-hover 0.6s ease;
	}
	svg:hover {
		--el-hover: 1;
	}

	@keyframes el-loop {
		0%, 15%, 85%, 100% { --el-loop: 0; }
		35%, 65% { --el-loop: 1; }
	}
	@keyframes el-labels {
		0%, 30%, 70%, 100% { --el-labels: 0; }
		40%, 60% { --el-labels: 1; }
	}

	.layer {
		--el-apart: calc(var(--el-loop) * (1 - var(--el-hover)) + var(--el-hover));
		transform: translateY(calc((1.5 - var(--step)) * (25px + 50px * var(--el-apart))));
		transition: opacity 0.3s;
	}
	.label {
		opacity: calc(var(--el-labels) * (1 - var(--el-hover)) + var(--el-hover));
	}

	/* Hovering a layer highlights it and names the components that draw it */
	svg:has(.layer:hover) .layer:not(:hover) {
		opacity: 0.6;
	}
	.layer:hover .plate {
		stroke: var(--sl-color-accent, #3fcfad);
		stroke-dasharray: none;
	}
	.layer:hover .label-detail {
		opacity: 1;
	}

	figure {
		margin: 0;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--sl-font, var(--body, system-ui, sans-serif));
	}
	figcaption {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--sl-color-gray-3, #8e9098);
		text-align: center;
	}

	.label-title {
		fill: var(--sl-color-white, #ffffff);
		font-size: 15px;
		font-weight: 600;
	}
	.label-text {
		fill: var(--sl-color-gray-3, #8e9098);
		font-size: 12px;
	}
	.label-detail {
		fill: var(--sl-color-accent, #3fcfad);
		font-size: 12px;
		opacity: 0;
		transition: opacity 0.3s;
	}

	.plate {
		fill: color-mix(in srgb, var(--sl-color-white, #ffffff) 2%, transparent);
		stroke: color-mix(in srgb, var(--sl-color-white, #ffffff) 15%, transparent);
		stroke-dasharray: 4 3;
		transition: stroke 0.3s;
	}
	.plate.base {
		fill: var(--sl-color-black, #101114);
		stroke: var(--sl-color-gray-5, #2a2b31);
		stroke-dasharray: none;
	}
	.dot {
		fill: var(--sl-color-gray-4, #5c5e66);
	}
	.leader {
		stroke: var(--sl-color-gray-3, #8e9098);
		stroke-dasharray: 2 3;
	}

	.group {
		fill: color-mix(in srgb, var(--sl-color-accent, #3fcfad) 10%, transparent);
		stroke: var(--sl-color-accent, #3fcfad);
		stroke-width: 1.5;
	}
	.rectangle {
		fill: color-mix(in srgb, #5b8def 20%, transparent);
		stroke: #5b8def;
		stroke-width: 1.5;
	}
	.ellipse {
		fill: color-mix(in srgb, #e5559a 15%, transparent);
		stroke: #e5559a;
		stroke-width: 1.5;
	}
	.line {
		stroke: var(--sl-color-gray-2, #c4c5ca);
		stroke-width: 2;
	}
	.arrowhead {
		fill: var(--sl-color-gray-2, #c4c5ca);
	}
	.link line {
		stroke: var(--sl-color-gray-3, #8e9098);
		stroke-width: 2;
	}
	.node circle {
		fill: var(--sl-color-accent, #3fcfad);
		stroke: var(--sl-color-black, #101114);
		stroke-width: 2;
	}
	.text-line rect {
		fill: var(--sl-color-gray-2, #c4c5ca);
		opacity: 0.75;
	}
	.selection {
		fill: none;
		stroke: var(--sl-color-accent, #3fcfad);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.connection-arrow path {
		fill: var(--sl-color-accent, #3fcfad);
		fill-opacity: 0.45;
	}

	@media (prefers-reduced-motion: reduce) {
		svg {
			animation: none;
			--el-loop: 1;
			--el-labels: 1;
		}
	}
</style>
